+      if (o.deviceId != null) cfg.deviceId = String(o.deviceId);
+      if (o.cleanup != null) cfg.cleanup = !!o.cleanup;
+      if (o.channels != null && CHANNEL_MODES.includes(o.channels)) cfg.channels = o.channels;
