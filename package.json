{
  "name": "orograph",
  "productName": "Oro",
  "version": "2.17.0",
  "description": "Oro: a 3D wave terrain synthesizer. One land, played as terrain, subtractive, FM, wavetable, additive, granular, physical and vector colour. Place the dot, twist knobs, or hand it a score.",
  "author": "Chase",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "orograph.desktop",
  "homepage": "https://github.com/ChaseHendrick/Oro",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChaseHendrick/Oro.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icons": "node dev/packaging/make-icons.cjs",
    "test:electron": "node tests/e2e/electron-smoke.cjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.hendrickresearch.orograph",
    "productName": "Oro",
    "copyright": "Copyright (c) 2026 Chase",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en",
      "en-US"
    ],
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "ChaseHendrick",
      "repo": "Oro",
      "private": false,
      "releaseType": "release"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "artifactName": "Oro-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Oro listens to a microphone or audio input only when you turn on Voice in Settings > Voice (to hear and loop your vocals, play notes by singing and capture sung notes as terrains) or the pedal return in Settings > Pedals (to hear your guitar pedals and measure their latency)."
      }
    },
    "dmg": {
      "artifactName": "Oro-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oro",
      "uninstallDisplayName": "Oro",
      "artifactName": "Oro-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Oro-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "executableName": "orograph",
      "synopsis": "3D wave terrain synthesizer",
      "artifactName": "Oro-linux-${arch}.${ext}",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
